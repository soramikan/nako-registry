{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nako.toml の JSON 変換後の構造",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "package": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/packageId"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "readme": {
          "$ref": "#/$defs/relativePath"
        },
        "engines": {
          "$ref": "#/$defs/engines"
        }
      }
    },
    "exports": {
      "$ref": "#/$defs/exports"
    },
    "features": {
      "$ref": "#/$defs/features"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "universal": {
          "type": "object",
          "properties": {
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "include"
          ]
        },
        "esm": {
          "type": "object",
          "properties": {
            "runtimes": {
              "$ref": "#/$defs/esmRuntimes"
            },
            "entry": {
              "$ref": "#/$defs/relativePath"
            },
            "include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "runtimes",
            "entry",
            "include"
          ]
        },
        "native": {
          "type": "object",
          "properties": {
            "abi_version": {
              "type": "integer"
            },
            "source_include": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prebuilt_lib_name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "abi_version"
          ]
        }
      }
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "runtime-dependencies": {
      "type": "object",
      "properties": {
        "lnako": {
          "$ref": "#/$defs/dependencies"
        },
        "cnako": {
          "$ref": "#/$defs/dependencies"
        },
        "wnako": {
          "$ref": "#/$defs/dependencies"
        }
      },
      "additionalProperties": false
    },
    "dev-dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "runtime": {
            "$ref": "#/$defs/runtime"
          }
        },
        "required": [
          "runtime"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "package"
  ],
  "additionalProperties": false,
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^@(?![^/]*--)[a-z][a-z0-9-]{0,37}[a-z0-9]/(?![^/]*--)[a-z](?:[a-z0-9-]{0,62}[a-z0-9])?(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
    },
    "publicVersion": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "runtime": {
      "enum": [
        "lnako",
        "cnako",
        "wnako"
      ]
    },
    "runtimes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtime"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "esmRuntimes": {
      "type": "array",
      "items": {
        "enum": [
          "cnako",
          "wnako"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "pure-nako",
          "native",
          "ffi",
          "fs",
          "net",
          "env",
          "process",
          "unsafe"
        ]
      }
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*[\\\\\\u0000-\\u001f\\u007f-\\u009f])(?!(?:[^/]+/)*[A-Za-z]:)(?!(?:[^/]+/)*\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*(?![\\s\\S])"
    },
    "subpath": {
      "anyOf": [
        {
          "const": "."
        },
        {
          "type": "string",
          "pattern": "^\\./(?!(?:[^/]+/)*\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*(?![\\s\\S])"
        }
      ]
    },
    "binding": {
      "enum": [
        "scoped",
        "global"
      ]
    },
    "engines": {
      "type": "object",
      "properties": {
        "lnako": {
          "$ref": "#/$defs/semverRange"
        },
        "cnako": {
          "$ref": "#/$defs/semverRange"
        },
        "wnako": {
          "$ref": "#/$defs/semverRange"
        }
      },
      "additionalProperties": false
    },
    "exports": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "entry": {
            "$ref": "#/$defs/relativePath"
          },
          "binding": {
            "$ref": "#/$defs/binding",
            "default": "scoped"
          }
        },
        "required": [
          "entry"
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/subpath"
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/semverRange"
          },
          {
            "type": "object",
            "properties": {
              "version": {
                "$ref": "#/$defs/semverRange"
              },
              "alias": {
                "type": "string",
                "minLength": 1
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allow_global_commands": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "version"
            ]
          }
        ]
      },
      "propertyNames": {
        "$ref": "#/$defs/packageId"
      }
    },
    "semverRange": {
      "type": "string",
      "description": "node-semver 7.7.4 の既定の範囲構文。文法と適合判定は利用側で検証する。"
    }
  }
}
